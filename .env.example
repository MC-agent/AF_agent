# Deployment Configuration
DEPLOY_ENV="local"
ENABLE_PIPELINE_ROUTES=true

# App Database / Vector Store (PostgreSQL)
# By default the app can reuse the same PostgreSQL database for app tables and pgvector.
# Leave PGVECTOR_DATABASE_URL unset to reuse DATABASE_URL or the PG_* values below.
PG_HOST="your_rds_or_postgres_host_here"
PG_PORT="5432"
PG_USER="postgres"
PG_PASSWORD="your_postgres_password_here"
PG_DATABASE="your_postgres_database_here"

# Optional explicit URLs
# DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/af_vectors"
# PGVECTOR_DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/af_vectors"

# LLM / Tracing
OPENROUTER="your_openrouter_api_key_here"
OPENROUTER_API_BASE="https://openrouter.ai/api/v1"
OPENAI_API_KEY="your_openai_api_key_here"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_PROJECT="your_project_name"
LANGCHAIN_API_KEY="your_langchain_api_key_here"

# External APIs
KAKAO_API_KEY="your_kakao_api_key_here"

# Auth
SECRET_KEY="your_secret_key_here"
