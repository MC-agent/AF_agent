{
  "info": {
    "name": "AF Agent API",
    "description": "Translation Agent and Integrated Pipeline API Server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 로그인 요청 자체는 스킵",
          "const skipPaths = ['/api/auth/login', '/api/auth/signup'];",
          "const currentUrl = pm.request.url.toString();",
          "const isAuthRequest = skipPaths.some(p => currentUrl.includes(p));",
          "if (isAuthRequest) return;",
          "",
          "// 토큰이 있으면 만료 여부 체크",
          "const token = pm.collectionVariables.get('token');",
          "if (token) {",
          "    try {",
          "        const payload = JSON.parse(atob(token.split('.')[1]));",
          "        const expMs = payload.exp * 1000;",
          "        // 만료까지 60초 이상 남아 있으면 재로그인 불필요",
          "        if (Date.now() < expMs - 60000) return;",
          "    } catch(e) {",
          "        // decode 실패 시 재로그인 진행",
          "    }",
          "}",
          "",
          "// 토큰 없거나 만료 임박 → 로그인 요청",
          "const baseUrl = pm.collectionVariables.get('base_url');",
          "const email    = pm.collectionVariables.get('login_email');",
          "const password = pm.collectionVariables.get('login_password');",
          "",
          "pm.sendRequest({",
          "    url: baseUrl + '/api/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: {",
          "        mode: 'raw',",
          "        raw: JSON.stringify({ email, password })",
          "    }",
          "}, (err, res) => {",
          "    if (err) {",
          "        console.error('Auto-login failed:', err);",
          "        return;",
          "    }",
          "    const body = res.json();",
          "    if (body.access_token) {",
          "        pm.collectionVariables.set('token', body.access_token);",
          "        console.log('Auto-login success. Token refreshed.');",
          "    } else {",
          "        console.error('Auto-login: no token in response', body);",
          "    }",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "login_email",
      "value": "user@example.com",
      "type": "string",
      "description": "자동 로그인에 사용할 이메일"
    },
    {
      "key": "login_password",
      "value": "password123",
      "type": "string",
      "description": "자동 로그인에 사용할 비밀번호"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT 액세스 토큰 (자동 관리)"
    },
    {
      "key": "chat_id",
      "value": "",
      "type": "string",
      "description": "채팅 생성 시 자동 저장"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "회원가입",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/signup",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "signup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"홍길동\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "회원가입 (인증 불필요)"
          },
          "response": []
        },
        {
          "name": "로그인",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set('token', res.access_token);",
                  "    console.log('Token saved:', res.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "수동 로그인. 성공 시 {{token}}에 자동 저장됩니다."
          },
          "response": []
        },
        {
          "name": "로그아웃",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "로그아웃"
          },
          "response": []
        },
        {
          "name": "내 정보 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "현재 로그인한 사용자 정보 조회"
          },
          "response": []
        }
      ]
    },
    {
