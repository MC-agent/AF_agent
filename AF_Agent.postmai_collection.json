{
  "info": {
    "name": "AF Agent API",
    "description": "Postman collection aligned with the current FastAPI routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const skipPaths = ['/api/auth/login', '/api/auth/signup', '/api/auth/refresh'];",
          "const currentUrl = pm.request.url.toString();",
          "const shouldSkip = skipPaths.some((path) => currentUrl.includes(path));",
          "if (shouldSkip) return;",
          "",
          "const token = pm.collectionVariables.get('token');",
          "if (token) {",
          "  try {",
          "    const payload = JSON.parse(atob(token.split('.')[1]));",
          "    const expMs = payload.exp * 1000;",
          "    if (Date.now() < expMs - 60000) return;",
          "  } catch (error) {",
          "    console.log('Token decode failed, trying auto-login.');",
          "  }",
          "}",
          "",
          "const baseUrl = pm.collectionVariables.get('base_url');",
          "const email = pm.collectionVariables.get('login_email');",
          "const password = pm.collectionVariables.get('login_password');",
          "",
          "pm.sendRequest({",
          "  url: baseUrl + '/api/auth/login',",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: {",
          "    mode: 'raw',",
          "    raw: JSON.stringify({ email, password })",
          "  }",
          "}, (err, res) => {",
          "  if (err) {",
          "    console.error('Auto-login failed:', err);",
          "    return;",
          "  }",
          "  const body = res.json();",
          "  if (body.access_token) {",
          "    pm.collectionVariables.set('token', body.access_token);",
          "  }",
          "  if (body.refresh_token) {",
          "    pm.collectionVariables.set('refresh_token', body.refresh_token);",
          "  }",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "login_email",
      "value": "user@example.com",
      "type": "string"
    },
    {
      "key": "login_password",
      "value": "Password1!",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "chat_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password1!\",\n  \"name\": \"Postman User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Create a user account. Password must satisfy the current validation rules."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) pm.collectionVariables.set('token', res.access_token);",
                  "if (res.refresh_token) pm.collectionVariables.set('refresh_token', res.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Log in and store access_token and refresh_token as collection variables."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) pm.collectionVariables.set('token', res.access_token);",
                  "if (res.refresh_token) pm.collectionVariables.set('refresh_token', res.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Exchange refresh_token for a new access_token and refresh_token."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "JWT logout endpoint. The server validates the bearer token."
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Read the current authenticated user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "List Chats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/chats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "chats"
              ]
            },
            "description": "List chats for the current authenticated user."
          },
          "response": []
        },
        {
          "name": "Create Chat",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('chat_id', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/chats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "chats"
              ]
            },
            "description": "Create an empty chat. Current route does not accept a request body."
          },
          "response": []
        },
        {
          "name": "Get Chat",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/chats/{{chat_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "chats",
                "{{chat_id}}"
              ]
            },
            "description": "Fetch a chat by id."
          },
          "response": []
        },
        {
          "name": "List Messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/chats/{{chat_id}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "chats",
                "{{chat_id}}",
                "messages"
              ]
            },
            "description": "List all messages in the selected chat."
          },
          "response": []
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/chats/{{chat_id}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "chats",
                "{{chat_id}}",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Recommend restaurants in Gangnam\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Send a user message and receive the generated assistant reply."
          },
          "response": []
        },
        {
          "name": "Delete Chat",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/chats/{{chat_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "chats",
                "{{chat_id}}"
              ]
            },
            "description": "Delete the selected chat."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pipeline",
      "item": [
        {
          "name": "Run Pipeline",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pipeline/run",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pipeline",
                "run"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"restaurant\",\n  \"search_queries\": [\"Gangnam restaurants\"],\n  \"limit_per_query\": 10,\n  \"crawl_limit\": 5,\n  \"recreate_collection\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Run the search -> crawl -> insert pipeline in the background."
          },
          "response": []
        },
        {
          "name": "Pipeline Status",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pipeline/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pipeline",
                "status"
              ]
            },
            "description": "Check background pipeline status."
          },
          "response": []
        },
        {
          "name": "Upload Crawled Data",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pipeline/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pipeline",
                "upload"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"place_type\": \"restaurant\",\n  \"places\": [\n    {\n      \"place_id\": \"11463001\",\n      \"basic_info\": {\n        \"name\": \"Sample Place\",\n        \"category\": \"Restaurant\"\n      },\n      \"home\": {},\n      \"menu\": {},\n      \"review\": {},\n      \"blog_review\": {},\n      \"photo\": {},\n      \"location\": {}\n    }\n  ],\n  \"recreate_collection\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Upload already crawled place payloads."
          },
          "response": []
        }
      ]
    },
    {
      "name": "General",
      "item": [
        {
