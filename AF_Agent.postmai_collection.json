              "host": ["{{base_url}}"],
              "path": ["api", "chats", "{{chat_id}}", "messages"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"강남 맛집 추천해줘\"\n}",
              "options": { "raw": { "language": "json" } }
            },
